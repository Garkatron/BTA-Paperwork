package deus.paperwork.entities.employee;

import net.minecraft.core.data.gamerule.GameRules;
import net.minecraft.core.entity.ConsumedFood;
import net.minecraft.core.entity.Mob;
import net.minecraft.core.item.ItemFood;
import net.minecraft.core.item.ItemStack;
import org.jetbrains.annotations.NotNull;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public final class DigestiveSystem {

	static class ConsumedFood {
		private final @NotNull Mob entity;
		private final @NotNull ItemStack stack;
		private final @NotNull ItemFood foodItem;
		private int healRemaining;
		private int tickCounter = 0;

		public ConsumedFood(@NotNull Mob entity, @NotNull ItemStack stack) {
			this.entity = entity;
			this.stack = stack;
			this.foodItem = (ItemFood)stack.getItem();
			this.healRemaining = this.foodItem.getHealAmount(this.stack);
		}

		public void addFood(@NotNull ItemStack additionalStack) {
			this.healRemaining += this.foodItem.getHealAmount(additionalStack);
		}

		public int getHealRemaining() {
			return this.healRemaining;
		}

		public boolean isFinished() {
			return this.healRemaining <= 0;
		}

		public void tick() {
			if (!this.isFinished()) {
				++this.tickCounter;
				if (this.tickCounter >= this.foodItem.getTicksPerHeal(this.stack)) {
					this.tickCounter = 0;
					--this.healRemaining;
					this.entity.heal(1);
				}

			}
		}
	}



	private Map<String, ConsumedFood> consumedFood = new HashMap<>();


	public void tick() {
		List<String> finishedFood = new ArrayList();

		for(Map.Entry<String, ConsumedFood> entry : this.consumedFood.entrySet()) {
			((ConsumedFood)entry.getValue()).tick();
			if (((ConsumedFood)entry.getValue()).isFinished()) {
				finishedFood.add((String)entry.getKey());
			}
		}

		for(String foodKey : finishedFood) {
			this.consumedFood.remove(foodKey);
		}
	}

	public void eatFood(ItemStack stack) {
		if (stack != null && stack.getItem() instanceof ItemFood) {
			ItemFood foodItem = (ItemFood)stack.getItem();
			if (foodItem.getTicksPerHeal(stack) != 0 && !(Boolean)this.world.getGameRuleValue(GameRules.INSTANT_HEALING)) {
				String key = stack.getItemKey();
				if (this.consumedFood.containsKey(key)) {
					((ConsumedFood)this.consumedFood.get(key)).addFood(stack);
				} else {
					this.consumedFood.put(key, new ConsumedFood(this, stack));
				}
			} else {
				this.heal(foodItem.getHealAmount(stack));
			}

		}
	}

	public int getTotalHealingRemaining() {
		int totalHealingRemaining = 0;

		for(ConsumedFood value : this.consumedFood.values()) {
			totalHealingRemaining += value.getHealRemaining();
		}

		return totalHealingRemaining;
	}
}
